#!/usr/bin/env bash
# Branch-naming rule from .github/CONTRIBUTING.md. Refuse push to main and to
# ref names outside <type>/<short-kebab-summary>.
# Activate per clone: git config core.hooksPath .githooks

set -e

allowed='^(feat|fix|perf|refactor|test|docs|chore|ci)/[a-z0-9]+(-[a-z0-9]+)*$'
bypass='^(dependabot|renovate)/'  # bot branch skip local convention

fail=0
# Name checked is remote_ref, never local: `git push origin HEAD:main` carry
# local_ref HEAD and `git push origin feat/x:main` carry conforming one, so both
# reach main past a local-name check.
while read -r _local_ref local_sha remote_ref _remote_sha; do
    # Deletion push = all-zero sha, no branch name to check.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    # Tag push land here too, and release tags carry no branch rule.
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    branch="${remote_ref#refs/heads/}"

    if [ "$branch" = "main" ]; then
        printf 'pre-push: direct push to main not allowed; open a PR from a branch.\n' >&2
        fail=1
        continue
    fi
    printf '%s' "$branch" | grep -qE "$bypass" && continue
    if ! printf '%s' "$branch" | grep -qE "$allowed"; then
        printf "pre-push: '%s' violates <type>/<short-kebab-summary>.\n" "$branch" >&2
        printf '  allowed types: feat fix perf refactor test docs chore ci\n' >&2
        printf '  e.g. feat/token-tracking, fix/render-empty-segments\n' >&2
        fail=1
    fi
done

exit "$fail"
