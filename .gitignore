# Build output
/dist/
/knit-statusline
/statusline

# Binaries staged into the npm platform packages by the release pipeline
/npm/platforms/*/bin/*
!/npm/platforms/*/bin/.gitkeep

# README copied into the launcher package at stage time
/npm/knit-statusline/README.md

node_modules/

# Claude Code: only the shared hooks, skills and their wiring are tracked
.claude/*
!.claude/hooks/
!.claude/skills/
!.claude/settings.json
__pycache__/
