# Build output
/dist/
/knit-statusline
/statusline

# Release pipeline stage binaries into npm platform packages
/npm/platforms/*/bin/*
!/npm/platforms/*/bin/.gitkeep

# README copied into launcher package at stage time
/npm/knit-statusline/README.md

node_modules/

# Claude Code: shared hooks, settings.json and skills tracked, rest local
# .claude/* hide dir itself, so unnegated subtree never reach git status
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
__pycache__/
