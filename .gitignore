# Build output
/dist/
/knit-statusline
/statusline

# Binaries the release pipeline stage into npm platform packages
/npm/platforms/*/bin/*
!/npm/platforms/*/bin/.gitkeep

# README copied into launcher package at stage time
/npm/knit-statusline/README.md

node_modules/

# Claude Code: only shared hooks and their wiring tracked
.claude/*
!.claude/hooks/
!.claude/settings.json
__pycache__/
