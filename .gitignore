# Build output
/dist/
/knit-statusline
/statusline

# Release pipeline stage binaries into npm platform packages
/npm/platforms/*/bin/*
!/npm/platforms/*/bin/.gitkeep

# README and LICENSE copied into npm packages at stage time
/npm/knit-statusline/README.md
/npm/knit-statusline/LICENSE
/npm/platforms/*/LICENSE

node_modules/

# Claude Code: shared hooks, settings.json and skills tracked, rest local
# .claude/* hide dir itself, so unnegated subtree never reach git status
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/skills/

# Superpowers scratch: specs and plans belong to one session, not the repo
/docs/superpowers/
__pycache__/
